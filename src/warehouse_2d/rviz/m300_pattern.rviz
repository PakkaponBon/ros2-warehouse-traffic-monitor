Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 80
    - Class: rviz_default_plugins/Map
      Name: Warehouse Map
      Enabled: true
      Alpha: 0.55
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: M300 changing pattern (2.5 s accumulation)
      Enabled: true
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 2.5
      Position Transformer: XYZ
      Queue Size: 20
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.025
      Style: Flat Squares
      Topic:
        Value: /traffic/vehicle_1/m300/pointcloud
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 10
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Gazebo regular source (comparison)
      Enabled: false
      Alpha: 0.35
      Color Transformer: FlatColor
      Color: 180; 180; 180
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.015
      Style: Points
      Topic:
        Value: /traffic/vehicle_1/m300/raw_points
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: M300 horizontal slice
      Enabled: false
      Color: 255; 220; 50
      Topic:
        Value: /traffic/vehicle_1/m300/scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.04
      Style: Points
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Background Color: 25; 28; 33
    Fixed Frame: vehicle_1/m300_lidar
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.65
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1400
