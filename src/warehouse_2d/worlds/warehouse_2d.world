    <!-- These models are tracked through /gazebo/model_states and driven by
         the per-model planar motion plugins below. -->
    <model name="vehicle_1">
      <pose>-17 -9 0.3 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>20</mass>
          <inertia>
            <ixx>1</ixx>
            <iyy>1</iyy>
            <izz>1</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.9 0.6 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.9 0.6 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.45 0.05 1</ambient>
          </material>
        </visual>
      </link>
      <plugin name="planar_move_1" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/traffic/vehicle_1</namespace>
        </ros>
        <update_rate>50</update_rate>
        <publish_rate>10</publish_rate>
        <publish_odom>false</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <odometry_frame>odom_vehicle_1</odometry_frame>
        <robot_base_frame>body</robot_base_frame>
      </plugin>
    </model>
