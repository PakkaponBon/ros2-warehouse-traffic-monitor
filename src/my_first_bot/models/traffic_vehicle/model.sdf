<?xml version="1.0"?>
<sdf version="1.6">
  <model name="traffic_vehicle">
    <link name="body">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>1.0</ixx>
          <iyy>1.0</iyy>
          <izz>1.0</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.9 0.6 0.6</size></box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry>
          <box><size>0.9 0.6 0.38</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.70 1.0 1.0</ambient>
          <diffuse>0.15 0.70 1.0 1.0</diffuse>
        </material>
      </visual>
      <visual name="top_visual">
        <pose>0 0 0.22 0 0 0</pose>
        <geometry>
          <box><size>0.46 0.42 0.18</size></box>
        </geometry>
        <material>
          <ambient>0.05 0.25 0.38 1.0</ambient>
          <diffuse>0.08 0.42 0.62 1.0</diffuse>
        </material>
      </visual>
      <visual name="front_marker">
        <pose>0.46 0 0.03 0 1.5708 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.75 0.10 1.0</ambient>
          <diffuse>1.0 0.75 0.10 1.0</diffuse>
        </material>
      </visual>
      <visual name="left_wheels">
        <pose>0 -0.31 -0.12 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.15</radius><length>0.08</length></cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.04 0.05 1.0</ambient>
          <diffuse>0.03 0.04 0.05 1.0</diffuse>
        </material>
      </visual>
      <visual name="right_wheels">
        <pose>0 0.31 -0.12 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.15</radius><length>0.08</length></cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.04 0.05 1.0</ambient>
          <diffuse>0.03 0.04 0.05 1.0</diffuse>
        </material>
      </visual>
    </link>
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <update_rate>50</update_rate>
      <publish_rate>10</publish_rate>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>body</robot_base_frame>
    </plugin>
  </model>
</sdf>
