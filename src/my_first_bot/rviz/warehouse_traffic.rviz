Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 50
    - Class: rviz_default_plugins/Map
      Name: Warehouse Map
      Enabled: true
      Alpha: 0.7
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Localized AMR
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Main AMR 2-D scan
      Enabled: true
      Topic:
        Value: /scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/LaserScan
      Name: Vehicle 1 2-D LiDAR
      Enabled: true
      Color: 0; 255; 180
      Topic:
        Value: /traffic/vehicle_1/scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.05
      Style: Points
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Vehicle 1 AMCL pose
      Enabled: true
      Topic:
        Value: /traffic/vehicle_1/amcl_pose
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: Historical Density
      Enabled: true
      Topic:
        Value: /traffic_history/density
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Stuck Locations
      Enabled: true
      Topic:
        Value: /traffic_history/stuck
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Congestion Hotspots
      Enabled: true
      Topic:
        Value: /traffic_history/congestion
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Background Color: 35; 38; 41
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Scale: 40
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
